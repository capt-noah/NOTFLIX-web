# ==============================================================================
# NOTFLIX ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# Follow the instructions below to obtain and fill in your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client)
# ------------------------------------------------------------------------------
# SUPABASE SETUP:
# 1. Create a free account & project at https://supabase.com
# 2. Go to: Project Settings -> API
#    - Project URL  -> Paste below as VITE_SUPABASE_URL
#    - Project API Keys ('anon' / 'public') -> Paste below as VITE_SUPABASE_ANON_KEY
# 3. Open Supabase SQL Editor and execute `supabase/schema.sql` to initialize tables & RPCs.
# 4. Under Authentication -> Providers -> Email, make sure Email signup is enabled.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# BACKEND API SERVER URL:
# - For Local Development: Keep `http://localhost:3001`
# - For All-in-One Railway Deployment: Leave EMPTY (uses same-origin `/api`)
# - For Separate Backend Deployment (e.g. Railway backend + Vercel frontend):
#   Set to your Railway backend URL (e.g. `https://your-app.up.railway.app`)
VITE_API_BASE=http://localhost:3001


# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Node.js Express Server)
# ------------------------------------------------------------------------------
# TMDB (The Movie Database) API SETUP:
# 1. Create a free account at https://www.themoviedb.org/
# 2. Go to: Settings -> API -> Request an API Key (Developer)
# 3. Copy your "API Key (v3 auth)" and paste it below.
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# SERVER PORT:
# Railway automatically assigns PORT at runtime. Defaults to 3001 locally.
PORT=3001
NODE_ENV=development